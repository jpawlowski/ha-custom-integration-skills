#!/usr/bin/env python3
"""Check that the marketplace, the plugin manifests and the skills agree with each other.

Usage:
    script/check
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CLAUDE_MARKETPLACE = ROOT / ".claude-plugin" / "marketplace.json"
CODEX_MARKETPLACE = ROOT / ".agents" / "plugins" / "marketplace.json"
AGENT_PLUGINS_SCHEMA = "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
NAME = re.compile(r"^haci-[a-z0-9]+(-[a-z0-9]+)*$")
FOREIGN_SKILL = re.compile(r"`((?:ha|blueprint)-[a-z]+(?:-[a-z]+)*)`")
LINK = re.compile(r"\]\(([^)#\s]+)(?:#[^)]*)?\)")

errors: list[str] = []


def fail(message: str) -> None:
    errors.append(message)


def load(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as err:
        fail(f"{path.relative_to(ROOT)}: {err}")
        return {}


def frontmatter(path: Path) -> dict[str, str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}
    block = text[4 : text.find("\n---", 4)]
    fields: dict[str, str] = {}
    key = None
    for line in block.splitlines():
        if match := re.match(r"^([a-z-]+):\s*(.*)$", line):
            key, value = match.groups()
            fields[key] = "" if value in (">-", ">", "|") else value
        elif key and line.startswith("  "):
            fields[key] = f"{fields[key]} {line.strip()}".strip()
    return fields


def implicit_invocation(path: Path) -> bool | None:
    """The value of policy.allow_implicit_invocation in a Codex agents/openai.yaml; None when absent or unreadable."""
    if not path.is_file():
        return None
    in_policy = False
    value = None
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        if not line.startswith((" ", "\t")):
            in_policy = line == "policy:"
            continue
        key, _, rest = line.strip().partition(":")
        if in_policy and key == "allow_implicit_invocation":
            value = {"true": True, "false": False}.get(rest.strip().lower())
    return value


def check_rules(path: Path) -> None:
    """A rules.md is copied verbatim into projects as a path-scoped instructions file, so it must stand alone there."""
    rel = path.relative_to(ROOT)
    text = path.read_text(encoding="utf-8")
    fields = frontmatter(path)
    if set(fields) != {"name", "description"} or not all(fields.values()):
        fail(f"{rel}: frontmatter must hold exactly a non-empty name and description — projects add the paths")
    body = text[text.find("\n---", 4) + 4 :].lstrip("\n") if text.startswith("---\n") else ""
    if not body.startswith("# "):
        fail(f"{rel}: the body must open with a # heading right after the frontmatter")
    for target in LINK.findall(text):
        if "://" not in target:
            fail(f"{rel}: relative link {target} breaks once the file is copied into a project — use an absolute URL")


def check_plugin(directory: Path, seen_skills: dict[str, str]) -> None:
    name = directory.name
    claude = load(directory / ".claude-plugin" / "plugin.json")
    portable = load(directory / "plugin.json")
    if portable.pop("$schema", None) != AGENT_PLUGINS_SCHEMA:
        fail(f"plugins/{name}/plugin.json: $schema must be {AGENT_PLUGINS_SCHEMA}")
    if claude != portable:
        fail(f"plugins/{name}: plugin.json and .claude-plugin/plugin.json differ")
    if claude.get("name") != name:
        fail(f"plugins/{name}: manifest name {claude.get('name')!r} is not the directory name")
    if not NAME.match(name):
        fail(f"plugins/{name}: plugin name must be haci- plus lowercase kebab-case")

    skills = sorted((directory / "skills").glob("*/SKILL.md"))
    if not skills:
        fail(f"plugins/{name}: no skills/<name>/SKILL.md")
    for skill in skills:
        rel = skill.relative_to(ROOT)
        fields = frontmatter(skill)
        skill_name = skill.parent.name
        if fields.get("name") != skill_name:
            fail(f"{rel}: frontmatter name {fields.get('name')!r} is not the directory name")
        if not NAME.match(skill_name) or len(skill_name) > 64:
            fail(f"{rel}: name must be haci- plus lowercase kebab-case, at most 64 characters")
        description = fields.get("description", "")
        if not description or len(description) > 1024:
            fail(f"{rel}: description must be 1-1024 characters, is {len(description)}")
        claude_blocked = fields.get("disable-model-invocation") == "true"
        codex_blocked = implicit_invocation(skill.parent / "agents" / "openai.yaml") is False
        if claude_blocked and not codex_blocked:
            fail(f"{rel}: invoke-only for Claude Code, but Codex may still load it — add agents/openai.yaml with "
                 "policy: allow_implicit_invocation: false")
        elif codex_blocked and not claude_blocked:
            fail(f"{rel}: invoke-only for Codex, but Claude Code may still load it — add disable-model-invocation: true")
        if skill_name in seen_skills:
            fail(f"{rel}: skill name also used in plugin {seen_skills[skill_name]} — agents that do not prefix collide")
        seen_skills[skill_name] = name

    for rules in sorted((directory / "skills").glob("*/references/rules.md")):
        check_rules(rules)

    for doc in directory.rglob("*.md"):
        text = doc.read_text(encoding="utf-8")
        for foreign in sorted(set(FOREIGN_SKILL.findall(text))):
            fail(f"{doc.relative_to(ROOT)}: names {foreign}, a skill this marketplace does not ship — describe the task")
        for target in LINK.findall(text):
            if "://" in target or target.startswith("mailto:"):
                continue
            resolved = (doc.parent / target).resolve()
            if not resolved.is_relative_to(directory.resolve()):
                fail(f"{doc.relative_to(ROOT)}: link {target} leaves the plugin — name the skill or file instead")
            elif not resolved.exists():
                fail(f"{doc.relative_to(ROOT)}: link {target} does not resolve")


def main() -> int:
    claude = load(CLAUDE_MARKETPLACE)
    codex = load(CODEX_MARKETPLACE)
    if claude.get("name") != codex.get("name"):
        fail("the two marketplace files carry different names")

    listed_claude = {p["name"]: p["source"] for p in claude.get("plugins", [])}
    listed_codex = {
        p["name"]: p["source"] if isinstance(p["source"], str) else p["source"].get("path")
        for p in codex.get("plugins", [])
    }
    on_disk = {d.name for d in (ROOT / "plugins").iterdir() if d.is_dir()}
    for label, listed in (("Claude/Copilot", listed_claude), ("Codex", listed_codex)):
        if set(listed) != on_disk:
            fail(f"{label} marketplace lists {sorted(listed)}, plugins/ holds {sorted(on_disk)}")
        for plugin, source in listed.items():
            if source != f"./plugins/{plugin}":
                fail(f"{label} marketplace: {plugin} has source {source!r}, expected ./plugins/{plugin}")
    for entry in codex.get("plugins", []):
        if entry.get("policy", {}).get("installation") not in {"AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"}:
            fail(f"Codex marketplace: {entry.get('name')} has no valid policy.installation")

    seen: dict[str, str] = {}
    versions = set()
    for directory in sorted((ROOT / "plugins").iterdir()):
        if directory.is_dir():
            check_plugin(directory, seen)
            versions.add(load(directory / "plugin.json").get("version"))
    if len(versions) > 1:
        fail(f"plugins carry different versions {sorted(map(str, versions))}; they are released together")

    for message in errors:
        print(f"✗ {message}", file=sys.stderr)
    if not errors:
        print(f"✓ {len(on_disk)} plugins, {len(seen)} skills")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
